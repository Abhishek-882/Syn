# Crypto Syndicate Sentinel - Environment Configuration Template
# Copy this file to .env and set your credentials (optional for ground-truth/mock mode)

# GMGN API Key
GMGN_API_KEY=your_gmgn_api_key_here

# Solscan API JWT Token (Header: token)
SOLSCAN_API_KEY=your_solscan_jwt_token_here

# Web Server Port (Automatically injected by Render / PaaS)
PORT=8000
